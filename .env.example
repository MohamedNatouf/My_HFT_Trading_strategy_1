ALPACA_API_KEY_ID=your_key_id
ALPACA_API_SECRET_KEY=your_secret
# paper | live   (live additionally requires LIVE_TRADING_CONFIRM=yes)
ALPACA_ENV=paper
LIVE_TRADING_CONFIRM=no
# Optional: iex (free) | sip (Algo Trader Plus)
ALPACA_DATA_FEED=iex

# --- Alerts (all optional, all free). Configure any subset. ---
# Push to your phone with the ntfy app: pick a long random topic name (anyone who knows it can read it)
ALERT_NTFY_TOPIC=
# Slack or Discord incoming-webhook URL
ALERT_WEBHOOK_URL=
# Telegram bot (create with @BotFather) + your chat id
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
# Email through your own mailbox (Gmail: use an app password)
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_EMAIL_TO=
# info | warning | critical
ALERT_MIN_LEVEL=warning
